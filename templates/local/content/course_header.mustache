{{#coursesEdukav}}
    <div class="edukav-breadcrumb-container" style="background-image: url('{{{hero_background}}}');">
        <div class="container">
            <div class="course-details-content edukav-course-hero">
                <div class="row row--20 align-items-center">
                    <div class="col-lg-6">
                        <div class="d-flex align-items-center gap-3 flex-wrap mb-2 edukav-course-partner">
                            {{#partner.logo}}
                                <img src="{{partner.logo}}" alt="{{partner.name}}" class="edukav-partner-logo">
                            {{/partner.logo}}
                        </div>
                        {{#partner.name}}
                            <div class="edukav-partner-info">
                                <span class="edukav-feature-text">{{#str}}partner, format_edukav{{/str}}:</span>
                                <span class="edukav-partner-name">{{partner.name}}</span>
                            </div>
                        {{/partner.name}}
                        <h2 class="edukav-breadcrumb-title mt--10">{{fullname}}</h2>
                        <div class="edukav-breadcrumb-description edukav-hero-summary">
                            {{{summary}}}
                        </div>
                        <div class="edukav-hero-metadata">
                            {{#duration}}
                                <span class="edukav-hero-chip"><i class="bi bi-clock"></i>{{duration}}</span>
                            {{/duration}}
                            {{#modulecount}}
                                <span class="edukav-hero-chip"><i class="bi bi-layers"></i>{{modulecount}} módulos</span>
                            {{/modulecount}}
                            {{#level}}
                                <span class="edukav-hero-chip"><i class="bi bi-bar-chart"></i>{{level}}</span>
                            {{/level}}
                        </div>
                        {{#activityprogress}}
                            <div class="edukav-hero-progress" aria-label="Tu progreso {{percentage}}%">
                                <div class="edukav-hero-progress-heading">
                                    <span>Tu progreso</span>
                                    <strong>{{percentage}}%</strong>
                                </div>
                                <div class="edukav-hero-progress-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{percentage}}">
                                    <span class="edukav-hero-progress-value" style="width: {{percentage}}%;"></span>
                                </div>
                            </div>
                        {{/activityprogress}}
                    </div>

                    <div class="col-lg-6">
                        <div class="radius-10 overflow-hidden bg-color-white-opacity mt_md--60 mt_sm--60 mt_mobile--40 edukav-hero-media-card">
                            {{#video_file_url}}
                                <video class="plyr edukav-course-video" controls preload="metadata" poster="{{course_image}}">
                                    <source src="{{video_file_url}}">
                                </video>
                            {{/video_file_url}}
                            {{^video_file_url}}
                            {{#video_id}}
                                <div class="plyr" data-plyr-provider="youtube" data-plyr-embed-id="{{video_id}}"></div>
                            {{/video_id}}
                            {{^video_id}}
                                <img class="placeholder-image" src="{{placeholder_image}}" alt="El video no ha sido cargado" class="img-fluid">
                            {{/video_id}}
                            {{/video_file_url}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{{/coursesEdukav}}
