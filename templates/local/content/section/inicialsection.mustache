{{#isgeneralsection}}
  <div class="edukav-general-section">
    <div class="edukav-welcome-card">
        {{> format_edukav/local/content/section/inicialsectionwelcome}}
    </div>
    <ul class="course-content pl-0">
      {{$ format_edukav/local/content/section }}
        {{> format_edukav/local/content/section }}
      {{/ format_edukav/local/content/section }}
    </ul>
    <div class="edukav-general-objectives{{^sectionheader.image}} edukav-general-objectives--textonly{{/sectionheader.image}}">
      {{#sectionheader.image}}
        <div class="edukav-general-objectives-media" style="background-image: url('{{{sectionheader.image}}}')"></div>
      {{/sectionheader.image}}
      <div class="edukav-general-objectives-copy">
        <div class="edukav-general-objectives-kicker">{{#str}}general:section_objectives,format_edukav{{/str}}</div>
        <div class="edukav-general-objectives-text">
          {{#objectiveshtml}}
            <div class="edukav-objectives-table-wrap">
              {{{objectiveshtml}}}
            </div>
          {{/objectiveshtml}}
          {{^objectiveshtml}}
            <p class="edukav-general-objectives-placeholder">Sin contenido.</p>
          {{/objectiveshtml}}
        </div>
      </div>
    </div>
    <div class="edukav-general-chrono">
      <div class="edukav-general-chrono-title">{{#str}}general:section_schedule,format_edukav{{/str}}</div>
      <div class="edukav-general-chrono-text">
        {{#generalcronogramahtml}}
          {{{generalcronogramahtml}}}
        {{/generalcronogramahtml}}
        {{^generalcronogramahtml}}
          <p class="edukav-general-chrono-placeholder">
            Agrega aqui fechas, hitos y el orden recomendado de trabajo.
          </p>
        {{/generalcronogramahtml}}
      </div>
    </div>
    <div class="edukav-chrono-zoom-overlay" aria-hidden="true" hidden>
      <button type="button" class="edukav-chrono-zoom-close" aria-label="Cerrar vista ampliada">×</button>
      <img class="edukav-chrono-zoom-image" alt="">
    </div>
  </div>
{{/isgeneralsection}}
{{^isgeneralsection}}
  <div class="edukav-splitview" data-region="edukav-splitview">
    <div class="edukav-sidebar-shell">
      <div class="edukav-sidebar-header">
        <span class="edukav-sidebar-header-title">Contenido del modulo</span>
      </div>
      <aside class="edukav-sidebar">
        {{$ format_edukav/local/content/section }}
          {{> format_edukav/local/content/section }}
        {{/ format_edukav/local/content/section }}
      </aside>
    </div>
    <main class="edukav-main">
      <div class="edukav-content-panel" data-region="splitview-content">
        {{#sectionnavigation}}
            {{$ format_edukav/local/content/sectionnavigation }}
              {{> format_edukav/local/content/sectionnavigation }}
            {{/ format_edukav/local/content/sectionnavigation }}
        {{/sectionnavigation}}
        <iframe
          class="edukav-activity-frame"
          src=""
          title="Vista previa de actividad"
          data-region="splitview-frame"
          frameborder="0"
          loading="lazy">
        </iframe>
      </div>
    </main>
  </div>
{{/isgeneralsection}}
