{{!
    @template format_cards/local/content/section-card

    Displays a section as a card. Does not display activities, just the section header

    Example context (json):
    {
        "id": 1234,
        "num": 1,
        "sectionreturnid": 0,
        "classes": [ "extra", "css", "classes" ],
        "header": {
            "url": "https://example.com/course/index.php",
            "name": "Section name",
            "image": "https://example.com/image.png",
            "summary": {
                "summarytext": "<p>Introductory text</p>"
            }
        }
    }
}}

<li class="card dashboard-card edukav-module-card{{#classes}} {{.}}{{/classes}}{{#completion}}{{^iscomplete}}{{#hasprogress}} is-inprogress{{/hasprogress}}{{/iscomplete}}{{/completion}}"
     role="listitem"
     aria-labelledby="section-{{num}}-title"
     data-sectionid="{{num}}"
     data-sectionreturnid="{{sectionreturnid}}"
     data-for="section"
     data-id="{{id}}"
     data-number="{{num}}">

    {{#header}}
        <a class="card-main-content" href="{{{url}}}" title="{{{name}}}">
            <div class="card-img-top edukav-module-card-media"
                 role="presentation"
                 {{#image}}style="background: url('{{{image}}}') center/cover"{{/image}}>
                {{> format_edukav/local/content/availability }}
                {{$ format_edukav/local/content/completion }}
                    {{> format_edukav/local/content/completion }}
                {{/ format_edukav/local/content/completion }}
            </div>
            <div class="edukav-module-card-body">
                {{$ core_courseformat/local/content/section/badges }}
                    {{> core_courseformat/local/content/section/badges }}
                {{/ core_courseformat/local/content/section/badges }}
                <h3 id="section-{{num}}-title" class="card-title">{{{name}}}</h3>
                <div class="edukav-module-card-meta">
                {{^isgeneralsection}}
                    {{#haslessoncount}}
                        <span><i class="bi bi-journal-text" aria-hidden="true"></i> {{lessoncount}} {{#str}}section:lessons, format_edukav{{/str}}</span>
                    {{/haslessoncount}}
                {{/isgeneralsection}}
                {{#hasmoduleduration}}<span><i class="bi bi-clock" aria-hidden="true"></i> {{moduleduration}}</span>{{/hasmoduleduration}}
                {{#completion}}
                    <span class="edukav-module-card-status{{#iscomplete}} is-complete{{/iscomplete}}{{^iscomplete}}{{#hasprogress}} is-inprogress{{/hasprogress}}{{^hasprogress}} is-notstarted{{/hasprogress}}{{/iscomplete}}">
                        {{#iscomplete}}
                            <i class="bi bi-check-circle-fill edukav-module-card-status-icon" aria-hidden="true"></i>
                            <span>{{#str}}section:status:completed, format_edukav{{/str}}</span>
                        {{/iscomplete}}
                        {{^iscomplete}}
                            {{#hasprogress}}
                                <i class="bi bi-clock-fill edukav-module-card-status-icon" aria-hidden="true"></i>
                                <span>{{#str}}section:status:inprogress, format_edukav{{/str}}</span>
                            {{/hasprogress}}
                            {{^hasprogress}}
                                <i class="bi bi-dash-circle-fill edukav-module-card-status-icon" aria-hidden="true"></i>
                                <span>{{#str}}section:status:notstarted, format_edukav{{/str}}</span>
                            {{/hasprogress}}
                        {{/iscomplete}}
                    </span>
                {{/completion}}
                </div>
                {{#summary}}
                    {{#summarytext}}<div class="summary">{{{summarytext}}}</div>{{/summarytext}}
                {{/summary}}
            </div>
        </a>
    {{/header}}

</li>
