{{!
    @template core_courseformat/local/content/sectionnavigation

    Displays the course section navigation.

    Example context (json):
    {
        "hasprevious": true,
        "hasparent": false,
        "previousurl": "#",
        "larrow": "&#x25C4;",
        "previousname": "Section 3",
        "hasnext": true,
        "rarrow": "&#x25BA;",
        "nexturl": "#",
        "nextname": "Section 5"
    }
}}


<div id="sectionnavigation-top" class="section-navigation navigationtitle edukav-section-navigation-bar">
    <div class="prevsection">
        {{#hasprevious}}
            <a href="{{{previousurl}}}"
               class="btn edukav-section-nav-btn edukav-section-nav-btn-prev{{#previoushidden}} text-muted{{/previoushidden}} btn-sm"
               data-action="previoussection"
               title="{{#str}}gotosection, format_edukav, {{previousname}}{{/str}}">
                <span class="edukav-section-nav-icon">
                    <span class="dir-ltr-hide">
                        {{#pix}}t/right, moodle, {{#str}}gotosection, format_edukav, {{previousname}}{{/str}}{{/pix}}
                    </span>
                    <span class="dir-rtl-hide">
                        {{#pix}}t/left, moodle, {{#str}}gotosection, format_edukav, {{previousname}}{{/str}}{{/pix}}
                    </span>
                </span>
                <span class="edukav-section-nav-text">{{#str}}navigation:previousmodule, format_edukav{{/str}}</span>
            </a>
        {{/hasprevious}}
        {{>format_edukav/local/content/section/button_splitview}}
        {{#showcoursehome}}
            <a href="{{{courseurl}}}"
               class="btn edukav-section-nav-btn edukav-section-nav-btn-home"
               data-action="coursehomebutton"
               title="{{#str}} course {{/str}}">
                <span class="edukav-section-nav-icon">
                    {{#pix}} i/home, core, {{#str}} maincoursepage {{/str}} {{/pix}}
                </span>
            </a>
        {{/showcoursehome}}
    </div>
    <div class="edukav-single-section-header-meta">
            <div class="edukav-single-section-title">
            {{{sectionheader.title}}}
            </div>
            <div class="edukav-single-section-progress-panel">
            <span class="edukav-single-section-progress-label">{{#str}}ProgressModule,format_edukav{{/str}}</span>
            {{#sectionprogress}}
                <div class="edukav-single-section-progress-bar">
                {{> block_myoverview/progress-bar }}
                </div>
            {{/sectionprogress}}
            <span class="edukav-single-section-progress-value">{{sectionprogresspercentage}}%</span>
            </div>
        </div>
    <div class="nextsection">
        {{#hasnext}}
            <a href="{{{nexturl}}}"
               class="btn edukav-section-nav-btn edukav-section-nav-btn-next{{#nexthidden}} text-muted{{/nexthidden}} btn-sm"
               data-action="nextsection"
               title="{{#str}}gotosection, format_edukav, {{nextname}}{{/str}}">
                <span class="edukav-section-nav-text">{{#str}}navigation:nextmodule, format_edukav{{/str}}</span>
                <span class="edukav-section-nav-icon">
                    <span class="dir-rtl-hide">
                        {{#pix}}t/right, moodle, {{#str}}gotosection, format_edukav, {{nextname}}{{/str}}{{/pix}}
                    </span>
                    <span class="dir-ltr-hide">
                        {{#pix}}t/left, moodle, {{#str}}gotosection, format_edukav, {{nextname}}{{/str}}{{/pix}}
                    </span>
                </span>
            </a>
        {{/hasnext}}
    </div>
</div>
